# Copy this file to .env and fill in your values
# .env is gitignored and must never be committed

# Optional: proxy settings for scraping
HTTP_PROXY=
HTTPS_PROXY=

# Optional: notification webhook (Slack, Teams, etc.)
WEBHOOK_URL=

# Database path (default: data/opportunities.db)
DB_PATH=data/opportunities.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
